{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "client/**"
    },
    "api/vouchers/[voucherId]/image.js": {
      "includeFiles": "client/assets/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/api"
    }
  ]
}